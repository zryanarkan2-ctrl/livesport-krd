import type { Match } from '@/types';

/** Match + ئەو خانانەی نوێ زیادمان کردوون (بێ گۆڕینی src/types) */
export type MatchX = Match & {
  /** slug ی ESPN بۆ لیگەکە، بۆ وردەکاری یاری و پلەبەندی */
  leagueSlug?: string;
  /** کاتی دەستپێکردن بە ISO، بۆ ڕیزکردن و بیرهێنەرەوە */
  startTime?: string;
};

/** 'live' = تەنها یاریە زیندووەکان، 'yesterday'|'today'|'tomorrow'، یان بەروار بە شێوەی YYYYMMDD */
export type DayKey = 'live' | 'yesterday' | 'today' | 'tomorrow' | (string & {});

export type EventKind = 'goal' | 'own-goal' | 'yellow' | 'red' | 'sub';

export interface MatchEvent {
  kind: EventKind;
  minute: string;
  isHome: boolean;
  player: string;
  /** یاریزانی دووەم: یارمەتیدەر یان جێگرەوە */
  extra?: string;
}

export interface StatRow {
  label: string;
  home: string;
  away: string;
  homeNum: number;
  awayNum: number;
}

export interface LineupPlayer {
  name: string;
  number: string;
  pos: string;
}

export interface TeamLineup {
  formation: string;
  starters: LineupPlayer[];
  subs: LineupPlayer[];
}

export interface MatchDetails {
  events: MatchEvent[];
  stats: StatRow[];
  lineups: { home: TeamLineup; away: TeamLineup } | null;
  venue?: string;
  attendance?: number;
  referee?: string;
}

export interface StandingRow {
  rank: number;
  teamId: number;
  team: string;
  logo: string;
  played: number;
  wins: number;
  draws: number;
  losses: number;
  gf: number;
  ga: number;
  gd: number;
  points: number;
}

export interface StandingGroup {
  name: string;
  rows: StandingRow[];
}

export interface NewsItem {
  id: string;
  headline: string;
  description: string;
  url: string;
  image: string;
  published: string;
}

import { useCallback, useEffect, useState } from 'react';

const KEY = 'lskrd_favs_v1';

export interface Favorites {
  teams: number[];
  leagues: number[];
}

const EMPTY: Favorites = { teams: [], leagues: [] };

function read(): Favorites {
  try {
    const raw = localStorage.getItem(KEY);
    if (!raw) return EMPTY;
    const p = JSON.parse(raw);
    return {
      teams: Array.isArray(p.teams) ? p.teams : [],
      leagues: Array.isArray(p.leagues) ? p.leagues : [],
    };
  } catch {
    return EMPTY;
  }
}

function write(f: Favorites) {
  try {
    localStorage.setItem(KEY, JSON.stringify(f));
    window.dispatchEvent(new Event('lskrd-favs'));
  } catch {
    // localStorage بەردەست نییە
  }
}

/** تیم و لیگە بەدڵەکان، لە localStorage هەڵدەگیرێن و لە هەموو کۆمپۆنێنتەکان هاوکات دەبن */
export function useFavorites() {
  const [favs, setFavs] = useState<Favorites>(read);

  useEffect(() => {
    const sync = () => setFavs(read());
    window.addEventListener('lskrd-favs', sync);
    window.addEventListener('storage', sync);
    return () => {
      window.removeEventListener('lskrd-favs', sync);
      window.removeEventListener('storage', sync);
    };
  }, []);

  const toggleTeam = useCallback((id: number) => {
    const cur = read();
    write({
      ...cur,
      teams: cur.teams.includes(id) ? cur.teams.filter((x) => x !== id) : [...cur.teams, id],
    });
  }, []);

  const toggleLeague = useCallback((id: number) => {
    const cur = read();
    write({
      ...cur,
      leagues: cur.leagues.includes(id) ? cur.leagues.filter((x) => x !== id) : [...cur.leagues, id],
    });
  }, []);

  const isTeamFav = useCallback((id: number) => favs.teams.includes(id), [favs]);
  const isLeagueFav = useCallback((id: number) => favs.leagues.includes(id), [favs]);

  return { favs, toggleTeam, toggleLeague, isTeamFav, isLeagueFav };
}

import type { MatchX } from './espn-types';

/**
 * بیرهێنەرەوەی پێش یاری.
 *
 * سنووردارییەکە: ئەمە تەنها کاتێک کار دەکات کە پەیجەکە (تاب) کراوە بێت، چونکە
 * بە setTimeout و Notification API ی وێبگەڕ کار دەکات. بۆ ئاگادارکردنەوەی ڕاستەقینە
 * کاتێک وێبگەڕ داخراوە، پێویستت بە Service Worker + Web Push + سێرڤەرە، کە پڕۆژەیەکی جیاوازە.
 */

const KEY = 'lskrd_reminders_v1';
const timers = new Map<string, number>();

interface Reminder {
  id: string;
  at: number; // کاتی ئاگادارکردنەوە (ms)
  title: string;
  body: string;
}

function load(): Reminder[] {
  try {
    return JSON.parse(localStorage.getItem(KEY) || '[]');
  } catch {
    return [];
  }
}

function save(list: Reminder[]) {
  try {
    localStorage.setItem(KEY, JSON.stringify(list));
    window.dispatchEvent(new Event('lskrd-reminders'));
  } catch {
    // localStorage بەردەست نییە
  }
}

export function notificationsSupported(): boolean {
  return typeof window !== 'undefined' && 'Notification' in window;
}

export async function ensureNotificationPermission(): Promise<boolean> {
  if (!notificationsSupported()) return false;
  if (Notification.permission === 'granted') return true;
  if (Notification.permission === 'denied') return false;
  return (await Notification.requestPermission()) === 'granted';
}

function arm(r: Reminder) {
  const delay = r.at - Date.now();
  if (delay <= 0 || delay > 2_000_000_000) return;
  window.clearTimeout(timers.get(r.id));
  timers.set(
    r.id,
    window.setTimeout(() => {
      try {
        new Notification(r.title, { body: r.body });
      } catch {
        // هیچ
      }
      removeReminder(r.id);
    }, delay),
  );
}

export function hasReminder(matchId: string): boolean {
  return load().some((r) => r.id === matchId);
}

export function removeReminder(matchId: string) {
  window.clearTimeout(timers.get(matchId));
  timers.delete(matchId);
  save(load().filter((r) => r.id !== matchId));
}

/** بیرهێنەرەوە دابنێ. false دەگەڕێنێتەوە ئەگەر ڕێگەپێدان نەدرا یان یاری دەستی پێکردووە */
export async function setReminder(match: MatchX, minutesBefore = 15): Promise<boolean> {
  if (!match.startTime) return false;
  const at = new Date(match.startTime).getTime() - minutesBefore * 60_000;
  if (at <= Date.now()) return false;
  if (!(await ensureNotificationPermission())) return false;

  const r: Reminder = {
    id: match.id,
    at,
    title: `${match.home.name} - ${match.away.name}`,
    body: `${match.league} · ${match.kickoff} (${minutesBefore} خولەکی تر)`,
  };
  save([...load().filter((x) => x.id !== r.id), r]);
  arm(r);
  return true;
}

/** لە دەستپێکی ئەپەکە یەک جار بانگ بکە، بۆ ئەوەی بیرهێنەرەوەکانی پێشوو دووبارە چالاک بن */
export function restoreReminders() {
  const now = Date.now();
  const alive = load().filter((r) => r.at > now);
  save(alive);
  alive.forEach(arm);
}
