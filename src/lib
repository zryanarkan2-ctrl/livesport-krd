export async function getNews(leagueSlug = 'all', limit = 20): Promise<NewsItem[]> {
  const data = await espnFetch(`${SITE_PATH}${leagueSlug}/news?limit=${limit}`);
  return (data.articles || []).map((a: any, i: number) => ({
