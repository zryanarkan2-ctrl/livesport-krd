
import { useEffect, useMemo, useState } from 'react';
import { RefreshCw, Search, Star } from 'lucide-react';
import { filterMatches, groupByLeague } from '@/lib/espn';
import { restoreReminders } from '@/lib/reminders';
import { useFavorites } from '@/lib/favorites';
import { useMatches } from '@/hooks/useMatches';
import type { DayKey, MatchX } from '@/lib/espn-types';
import { DayTabs } from '@/components/DayTabs';
import { EmptyDay } from '@/components/EmptyDay';
import { MatchDetailsModal } from '@/components/MatchDetailsModal';
import { ReminderBell, TeamStar } from '@/components/MatchActions';

/**
 * پەیجی نموونە کە هەموو پارچەکان پێکەوە دەبەستێتەوە.
 * دەتوانیت وەک پەیجی سەرەکی بەکاری بهێنیت، یان تەنها ئەو بەشانە لێوەربگریت کە دەتەوێت
 * و لە کۆمپۆنێنتە کۆنەکانی خۆت بەکاریان بهێنیت (بۆ نموونە: onClick={() => setOpen(match)}).
 */
function MatchRow({ m, onOpen }: { m: MatchX; onOpen: (m: MatchX) => void }) {
  const live = m.status === 'live';
  const upcoming = m.status === 'upcoming';

  return (
    <div
      role="button"
      tabIndex={0}
      onClick={() => onOpen(m)}
      onKeyDown={(e) => e.key === 'Enter' && onOpen(m)}
      className="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-800 bg-slate-900/60 px-3 py-3 transition hover:border-emerald-500/40"
      dir="ltr"
    >
      {/* کات / دۆخ */}
      <div className="w-16 text-center text-xs">
        {live ? (
          <span className="font-semibold text-red-400">● {m.minute != null ? `${m.minute}'` : m.statusShort}</span>
        ) : upcoming ? (
          <span className="text-slate-300">{m.kickoff}</span>
        ) : (
          <span className="text-slate-500">{m.statusShort || 'FT'}</span>
        )}
      </div>

      {/* خاوەن یاری */}
      <div className="flex flex-1 items-center justify-end gap-2">
        <TeamStar teamId={m.home.id} />
        <span className="truncate text-sm font-medium text-slate-100">{m.home.name}</span>
        {m.home.logo && <img src={m.home.logo} alt="" className="h-6 w-6 object-contain" />}
      </div>

      {/* ئەنجام */}
      <div className="w-14 text-center font-bold tabular-nums text-slate-100">
        {upcoming ? <span className="text-slate-500">-</span> : `${m.scoreHome} - ${m.scoreAway}`}
      </div>

      {/* میوان */}
      <div className="flex flex-1 items-center gap-2">
        {m.away.logo && <img src={m.away.logo} alt="" className="h-6 w-6 object-contain" />}
        <span className="truncate text-sm font-medium text-slate-100">{m.away.name}</span>
        <TeamStar teamId={m.away.id} />
      </div>

      <ReminderBell match={m} />
    </div>
  );
}

export default function MatchesPage() {
  const [day, setDay] = useState<DayKey>('today');
  const [query, setQuery] = useState('');
  const [favOnly, setFavOnly] = useState(false);
  const [open, setOpen] = useState<MatchX | null>(null);

  const { matches, loading, error, updatedAt, refresh } = useMatches(day);
  const { favs } = useFavorites();

  // بیرهێنەرەوە پاشەکەوتکراوەکان دووبارە چالاک بکەرەوە
  useEffect(() => {
    restoreReminders();
  }, []);

  const liveCount = matches.filter((m) => m.status === 'live').length;

  const groups = useMemo(() => {
    let list = filterMatches(matches, query);
    if (favOnly) {
      list = list.filter(
        (m) =>
          favs.teams.includes(m.home.id) || favs.teams.includes(m.away.id) || favs.leagues.includes(m.leagueId),
      );
    }
    return groupByLeague(list);
  }, [matches, query, favOnly, favs]);

  return (
    <main dir="rtl" className="mx-auto max-w-3xl space-y-4 px-4 py-6">
      <DayTabs value={day} onChange={setDay} liveCount={day === 'today' || day === 'live' ? liveCount : 0} />

      {/* گەڕان + بەدڵەکان + نوێکردنەوە */}
      <div className="flex items-center gap-2">
        <div className="flex flex-1 items-center gap-2 rounded-xl border border-slate-800 bg-slate-900/60 px-3">
          <Search className="h-4 w-4 text-slate-500" />
          <input
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            placeholder="گەڕان بە تیم یان لیگ..."
            className="w-full bg-transparent py-2.5 text-sm text-slate-100 outline-none placeholder:text-slate-500"
          />
        </div>
        <button
          type="button"
          onClick={() => setFavOnly((v) => !v)}
          title="تەنها بەدڵەکان"
          className={`rounded-xl border p-2.5 ${
            favOnly ? 'border-amber-400 bg-amber-400/10 text-amber-400' : 'border-slate-800 bg-slate-900/60 text-slate-400'
          }`}
        >
          <Star className={`h-4 w-4 ${favOnly ? 'fill-amber-400' : ''}`} />
        </button>
        <button
          type="button"
          onClick={refresh}
          title="نوێکردنەوە"
          className="rounded-xl border border-slate-800 bg-slate-900/60 p-2.5 text-slate-400 hover:text-white"
        >
          <RefreshCw className={`h-4 w-4 ${loading ? 'animate-spin' : ''}`} />
        </button>
      </div>

      {updatedAt && (
        <p className="text-xs text-slate-500">
          دوایین نوێبوونەوە: {new Date(updatedAt).toLocaleTimeString('en-GB', { timeZone: 'Asia/Baghdad' })}
        </p>
      )}

      {/* دۆخەکان */}
      {loading && matches.length === 0 && <p className="py-12 text-center text-slate-400">چاوەڕێ بە...</p>}

      {error && matches.length === 0 && (
        <div className="space-y-3 rounded-2xl border border-red-900/50 bg-red-950/20 py-12 text-center">
          <p className="text-red-300">نەتوانرا یاریەکان بهێنرێن</p>
          <button type="button" onClick={refresh} className="rounded-lg bg-red-500/20 px-4 py-2 text-sm text-red-200">
            هەوڵبدانەوە
          </button>
        </div>
      )}

      {!loading && !error && groups.length === 0 && (
        <EmptyDay day={day} hasSearch={Boolean(query) || favOnly} onGoToday={() => setDay('today')} />
      )}

      {/* لیستی یاریەکان بە گرووپی لیگ */}
      {groups.map((g) => (
        <section key={g.leagueId} className="space-y-2">
          <header className="flex items-center gap-2 px-1">
            {g.leagueLogo && <img src={g.leagueLogo} alt="" className="h-5 w-5 object-contain" />}
            <h2 className="font-semibold text-slate-100">{g.league}</h2>
            <span className="text-xs text-slate-500">{g.country}</span>
            <span className="ms-auto text-xs text-slate-500">{g.matches.length} یاری</span>
          </header>
          <div className="space-y-2">
            {(g.matches as MatchX[]).map((m) => (
              <MatchRow key={`${g.leagueId}-${m.id}`} m={m} onOpen={setOpen} />
            ))}
          </div>
        </section>
      ))}

      <MatchDetailsModal match={open} onClose={() => setOpen(null)} />
    </main>
  );
}
